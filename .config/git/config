[user]
    email = errestan@users.noreply.github.com
	name = Lee
[core]
	editor = nvim
    excludesFile = ~/.config/git/exclude.conf
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    default = simple
[fetch]
    prune = true
[difftool "nvim_difftool"]
    cmd = nvim -c \"packadd nvim.difftool\" -c \"DiffTool $LOCAL $REMOTE\"
[difftool]
    prompt = false
[diff]
    tool = nvim_difftool
[include]
    path = ~/.config/git/config.local
